# Copy to .env to override defaults. HUB_FERNET_KEY and HUB_CSRF_SECRET are
# generated into .env automatically on first run if missing.

# Where the SQLite database (and later backups, CVs, criteria) live.
# HUB_DATA_DIR=./data

# The address you open the hub at. Passkeys only work at this exact origin.
# Phone over Tailscale: https://<pi-name>.<tailnet>.ts.net
# HUB_PUBLIC_ORIGIN=http://localhost:8000

# Set to false only when testing over plain HTTP on a hostname other than
# localhost (e.g. http://192.168.1.20:8000), or sign-in cookies won't stick.
# HUB_COOKIE_SECURE=true

# HUB_FERNET_KEY=
# HUB_CSRF_SECRET=
